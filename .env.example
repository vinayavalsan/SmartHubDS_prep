# Copy to .env and fill in. Never commit the real .env.
# Keep this file's values as blank placeholders only — it IS tracked by git.

# --- SSH tunnel to the bastion host ---
SSH_HOST=
SSH_USER=
SSH_PRIVATE_KEY_PATH=~/.ssh/id_ed25519
SSH_PORT=22
# SSH_PRIVATE_KEY_PASSWORD=     # only if your key is passphrase-protected

# --- Redshift (reached through the tunnel) ---
REDSHIFT_HOST=
REDSHIFT_PORT=5439
REDSHIFT_DB=
REDSHIFT_USER=
REDSHIFT_PASSWORD=
REDSHIFT_CONNECT_TIMEOUT=10

# --- Storage (how pulled data is persisted) ---
STORAGE_BACKEND=both          # duckdb | parquet | both
DUCKDB_PATH=data/smarthub.duckdb
PARQUET_DIR=data/leads        # files: data/leads/YYYY/MM/DD-MM-YYYY.parquet
PARTITION_DATE_COL=created_at # column used to bucket rows into per-day files

# NOTE: task configs (training window, model_type, bid_step, …) live in
# config/smarthub.ini — NOT here. .env holds only secrets + connection settings.

# Tier-2 runtime config store (shared Postgres). In Docker this is set for the
# config service; override for local use. Secrets/connection stay here (env),
# NOT in the config UI.
# SMARTHUB_CONFIG_DB_URL=postgresql+psycopg2://prefect:prefect@postgres:5432/prefect

# Password to unlock the Config page in the dashboard (leave blank = locked).
CONFIG_ADMIN_PASSWORD=

# --- Prefect (orchestration; used by docker-compose.prefect.yml) ---
PREFECT_API_URL=http://prefect-server:4200/api
PREFECT_WORK_POOL=smarthub-pool
PREFECT_WORK_QUEUE=default

# --- Slack notifications (pipeline success + failure alerts) ---
# Leave SLACK_WEBHOOK_URL blank to disable all notifications (no-op).
# Create an Incoming Webhook: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
# Label shown on every message so you can tell environments apart (defaults to
# the hostname if blank), e.g. prod | staging | local.
SLACK_ENV_LABEL=
# Optional: who to @-mention on FAILURES only. Use a Slack id, e.g.
# <@U123ABC> for a user or <!subteam^S123> for a group. Blank = no mention.
SLACK_MENTION_ON_FAILURE=

# --- Container images (CD / auto-deploy) ---
# Both images live in ONE Docker Hub repo, split by tag prefix
# (worker-* / dashboard-*), so the free tier's single private repo is enough.
# Set IMAGE_REPO to <your Docker Hub account>/smarthub — the CD workflow pushes
#   ${DOCKERHUB_USERNAME}/smarthub:worker-latest    (+ :worker-<sha>)
#   ${DOCKERHUB_USERNAME}/smarthub:dashboard-latest (+ :dashboard-<sha>)
# so IMAGE_REPO must equal ${DOCKERHUB_USERNAME}/smarthub. IMAGE_TAG=latest is
# the rolling tag Watchtower follows; pin a <sha> to freeze a version.
IMAGE_REPO=
IMAGE_TAG=latest
# WATCHTOWER_POLL_INTERVAL=300   # seconds between registry checks (default 300)
# Private repo? The host must `docker login` so Watchtower can pull.

# --- Misc ---
LOG_LEVEL=INFO
# SMARTHUB_ROOT=/app   # override project root (e.g. inside a container)
