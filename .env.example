# Copy to .env and fill in. Never commit the real .env.

# --- SSH tunnel to the bastion host ---
SSH_HOST=
SSH_USER=
SSH_PRIVATE_KEY_PATH=~/.ssh/id_rsa
SSH_PORT=22

# --- Redshift (reached through the tunnel) ---
REDSHIFT_HOST=
REDSHIFT_PORT=5439
REDSHIFT_DB=
REDSHIFT_USER=
REDSHIFT_PASSWORD=
REDSHIFT_CONNECT_TIMEOUT=10

# --- Misc ---
LOG_LEVEL=INFO
# SMARTHUB_ROOT=/app   # override project root (e.g. inside a container)
